# ==============================================================================
# NetPulse Enterprise - Variáveis de Ambiente para Docker Compose
# ==============================================================================

# --- Portas no Host (Evita conflitos com outros serviços locais) ---
# Porta da Interface Web (Vite + Nginx) -> Acesse http://localhost:3000
FRONTEND_PORT=3000

# Porta da API REST & SSE (Go) -> Acesse http://localhost:8085/api/health
BACKEND_PORT=8085

# Porta externa do PostgreSQL (mapeada para acesso direto via DBeaver/psql)
POSTGRES_PORT=5434

# Portas dos Serviços de Telemetria de Roteadores
BMP_PORT=11019
SYSLOG_PORT=1514

# --- Banco de Dados PostgreSQL ---
POSTGRES_DB=netpulse
POSTGRES_USER=netpulse
POSTGRES_PASSWORD=netpulse_secret_pass_2026

# --- Segurança & Criptografia (Altere para produção) ---
# Chave de assinatura de tokens JWT (mínimo 32 caracteres)
JWT_SECRET=netpulse_super_secret_jwt_key_2026_enterprise_b2b

# Chave AES-256-GCM para criptografia de senhas de equipamentos em repouso
DEVICE_ENCRYPTION_KEY=netpulse-secret-aes256-key-prod32!

# --- Telemetria ---
# Intervalo de polling periódico em segundos
POLL_INTERVAL=45

# --- Licenciamento & Modo de Operação ---
# true = Modo livre, vitalício e ilimitado (sem necessidade de chave ou Servidor Master)
DISABLE_LICENSE_CHECK=true
NETPULSE_STANDALONE_MODE=true

# --- Carga Inicial de Dados ---
# false = Produção limpa (inicia com 0 roteadores, sem dados de desenvolvimento)
# true  = Importa roteadores de demonstração de devices.json
SEED_SAMPLE_DEVICES=false
